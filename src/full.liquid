{% comment %} Overhead — the aircraft over your home right now (adsb.lol), a port of dmellok/tesserae-widget-overhead. AGPL-3.0-or-later, https://github.com/PhyberApex/trmnl-overhead {% endcomment %}
{% capture sil_jet %}<svg viewBox="0 0 200 200" fill="currentColor"><g><path d="M100 6 C107 6 109 22 109 44 L109 152 C109 172 106 186 100 194 L100 6 Z"/><path d="M109 78 L194 130 L194 141 L109 112 Z"/><ellipse cx="133" cy="104" rx="5.5" ry="13"/><path d="M106 166 L142 186 L142 192 L106 182 Z"/></g><g transform="translate(200 0) scale(-1 1)"><path d="M100 6 C107 6 109 22 109 44 L109 152 C109 172 106 186 100 194 L100 6 Z"/><path d="M109 78 L194 130 L194 141 L109 112 Z"/><ellipse cx="133" cy="104" rx="5.5" ry="13"/><path d="M106 166 L142 186 L142 192 L106 182 Z"/></g><rect x="98.5" y="150" width="3" height="36"/></svg>{% endcapture %}
{% capture sil_wide %}<svg viewBox="0 0 200 200" fill="currentColor"><g><path d="M100 4 C109 4 112 22 112 46 L112 154 C112 174 108 188 100 196 L100 4 Z"/><path d="M112 70 L198 136 L198 150 L112 112 Z"/><ellipse cx="134" cy="100" rx="6" ry="14"/><ellipse cx="160" cy="118" rx="5.5" ry="13"/><path d="M108 164 L150 188 L150 195 L108 184 Z"/></g><g transform="translate(200 0) scale(-1 1)"><path d="M100 4 C109 4 112 22 112 46 L112 154 C112 174 108 188 100 196 L100 4 Z"/><path d="M112 70 L198 136 L198 150 L112 112 Z"/><ellipse cx="134" cy="100" rx="6" ry="14"/><ellipse cx="160" cy="118" rx="5.5" ry="13"/><path d="M108 164 L150 188 L150 195 L108 184 Z"/></g><rect x="98" y="146" width="4" height="40"/></svg>{% endcapture %}
{% capture sil_prop %}<svg viewBox="0 0 200 200" fill="currentColor"><g><path d="M100 10 C106 10 108 24 108 44 L108 150 C108 168 105 182 100 190 L100 10 Z"/><path d="M108 82 L196 84 L196 96 L108 100 Z"/><ellipse cx="138" cy="90" rx="6" ry="16"/><circle cx="138" cy="74" r="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 3"/><path d="M106 168 L144 170 L144 178 L106 180 Z"/></g><g transform="translate(200 0) scale(-1 1)"><path d="M100 10 C106 10 108 24 108 44 L108 150 C108 168 105 182 100 190 L100 10 Z"/><path d="M108 82 L196 84 L196 96 L108 100 Z"/><ellipse cx="138" cy="90" rx="6" ry="16"/><circle cx="138" cy="74" r="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 3"/><path d="M106 168 L144 170 L144 178 L106 180 Z"/></g><rect x="98.5" y="146" width="3" height="40"/></svg>{% endcapture %}
{% capture sil_light %}<svg viewBox="0 0 200 200" fill="currentColor"><g><path d="M100 28 C106 28 108 40 108 56 L108 140 C108 158 104 170 100 176 L100 28 Z"/><path d="M108 66 L194 66 L194 78 L108 80 Z"/><path d="M104 158 L136 160 L136 167 L104 168 Z"/></g><g transform="translate(200 0) scale(-1 1)"><path d="M100 28 C106 28 108 40 108 56 L108 140 C108 158 104 170 100 176 L100 28 Z"/><path d="M108 66 L194 66 L194 78 L108 80 Z"/><path d="M104 158 L136 160 L136 167 L104 168 Z"/></g><circle cx="100" cy="24" r="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 3"/><rect x="98.5" y="140" width="3" height="30"/></svg>{% endcapture %}
{% capture sil_biz %}<svg viewBox="0 0 200 200" fill="currentColor"><g><path d="M100 10 C105 10 107 24 107 44 L107 154 C107 172 104 186 100 192 L100 10 Z"/><path d="M107 86 L186 126 L186 135 L107 110 Z"/><path d="M104 170 L134 184 L134 190 L104 184 Z"/></g><g transform="translate(200 0) scale(-1 1)"><path d="M100 10 C105 10 107 24 107 44 L107 154 C107 172 104 186 100 192 L100 10 Z"/><path d="M107 86 L186 126 L186 135 L107 110 Z"/><path d="M104 170 L134 184 L134 190 L104 184 Z"/></g><ellipse cx="112" cy="150" rx="4" ry="9"/><ellipse cx="88" cy="150" rx="4" ry="9"/><rect x="98.5" y="152" width="3" height="34"/></svg>{% endcapture %}
{% capture sil_heli %}<svg viewBox="0 0 200 200" fill="currentColor"><circle cx="100" cy="92" r="78" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 4"/><g stroke="currentColor" stroke-width="5" stroke-linecap="round"><path d="M100 92 L100 18 M100 92 L172 92 M100 92 L100 166 M100 92 L28 92"/></g><ellipse cx="100" cy="96" rx="16" ry="38"/><rect x="97" y="128" width="6" height="58"/><rect x="86" y="180" width="28" height="4"/></svg>{% endcapture %}

{% assign hero = sky.aircraft[0] %}
{% assign look = "plate" %}
{% if sky.error == true %}{% assign look = "silent" %}
{% elsif sky.count == 0 %}{% assign look = "quiet" %}
{% elsif hero.photo %}{% assign look = "photo" %}{% endif %}
{% assign clock = sky.clock | default: "" %}
{% assign placeName = sky.place | default: trmnl.plugin_settings.custom_fields_values.place %}
{% assign portrait = "" %}{% if trmnl.device.orientation == "portrait" %}{% assign portrait = " oh--portrait" %}{% endif %}

<style>
  .oh { position: relative; width: 100%; height: 100%; box-sizing: border-box; overflow: hidden; background: #fff; color: #000;
        font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; font-variant-numeric: tabular-nums; display: flex; flex-direction: column; }
  .oh--photo { background: #000; color: #fff; }
  .oh__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .oh__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.55) 0, rgba(0,0,0,0) 26%, rgba(0,0,0,0) 46%, rgba(0,0,0,.88) 100%); }
  .oh__band { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 10px 24px; background: #000; color: #fff;
              font-size: 20px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; position: relative; }
  .oh__band span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .oh__band span:last-child { font-weight: 400; letter-spacing: .04em; flex: none; }
  .oh--photo .oh__band { background: none; padding-top: 16px; text-shadow: 0 1px 3px rgba(0,0,0,.8); }
  .oh__credit { position: absolute; right: 24px; top: 54px; font-size: 15px; text-shadow: 0 1px 3px rgba(0,0,0,.8); font-style: italic; }

  .oh__main { position: absolute; left: 24px; bottom: 22px; width: 440px; text-shadow: 0 1px 4px rgba(0,0,0,.85); }
  .oh__main .oh__line { white-space: normal; line-height: 1.25; }
  .oh__cs { font-size: 92px; font-weight: 800; line-height: .92; letter-spacing: -.03em; white-space: nowrap; }
  .oh__cs small { font-size: 26px; font-weight: 400; letter-spacing: .1em; vertical-align: middle; margin-left: 10px; border: 2px solid currentColor; padding: 2px 8px; border-radius: 4px; }
  .oh__typ { font-size: 28px; font-weight: 600; margin-top: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .oh__typ span { font-weight: 400; }
  .oh__line { font-size: 22px; margin-top: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .oh__route { font-size: 24px; margin-top: 6px; }
  .oh__route b { font-weight: 800; }
  .oh__route span { font-size: 20px; }
  .oh__arrow { width: 28px; height: 12px; margin: 0 6px; vertical-align: middle; }

  .oh__strip { position: absolute; right: 24px; bottom: 22px; width: 290px; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .oh__strip li { display: flex; gap: 10px; align-items: center; background: rgba(0,0,0,.62); padding: 6px; border-radius: 4px; }
  .oh__th { width: 72px; height: 48px; object-fit: cover; flex: none; background: #000; border-radius: 2px; }
  .oh__th--sil { display: flex; align-items: center; justify-content: center; }
  .oh__th--sil svg { width: 40px; height: 40px; }
  .oh__tht { display: flex; flex-direction: column; line-height: 1.15; font-size: 15px; min-width: 0; }
  .oh__tht b { font-size: 19px; }
  .oh__tht span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .oh__body { flex: 1; display: flex; min-height: 0; overflow: hidden; }
  .oh__plate { width: 312px; flex: none; margin: 18px 0 18px 24px; border: 2px solid #000; outline: 1px solid #000; outline-offset: 4px; position: relative; display: flex; align-items: center; justify-content: center; }
  .oh__plate svg { width: 232px; height: 232px; display: block; }
  .oh__plate i { position: absolute; width: 22px; height: 22px; border: 2px solid #000; }
  .oh__plate i.tl { left: -8px; top: -8px; border-right: 0; border-bottom: 0; } .oh__plate i.tr { right: -8px; top: -8px; border-left: 0; border-bottom: 0; }
  .oh__plate i.bl { left: -8px; bottom: -8px; border-right: 0; border-top: 0; } .oh__plate i.br { right: -8px; bottom: -8px; border-left: 0; border-top: 0; }
  .oh__fig { position: absolute; left: 0; right: 0; bottom: 10px; text-align: center; font-size: 15px; font-style: italic; letter-spacing: .04em; }
  .oh__note { flex: 1; min-width: 0; padding: 14px 24px 0 26px; display: flex; flex-direction: column; }
  .oh__note .oh__cs { font-size: 72px; }
  .oh__note .oh__cs small { font-size: 20px; }
  .oh__note .oh__typ { font-size: 24px; margin-top: 8px; }
  .oh__note .oh__route { margin-top: 4px; }
  .oh__stats { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 18px; margin-top: 12px; }
  .oh__st { border-top: 2px solid #000; padding-top: 4px; }
  .oh__st small { display: block; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; }
  .oh__st b { font-size: 30px; font-weight: 800; line-height: 1.05; white-space: nowrap; }

  .oh__row { flex: none; display: flex; gap: 0; border-top: 2px solid #000; margin: 0 24px; padding: 0; }
  .oh__row li { flex: 1; min-width: 0; list-style: none; display: flex; gap: 8px; align-items: center; padding: 8px 10px 10px 0; }
  .oh__row li + li { border-left: 1px solid #000; padding-left: 10px; }
  .oh__row svg { width: 36px; height: 36px; flex: none; }
  .oh__row .oh__th { width: 56px; height: 38px; }
  .oh__row .oh__tht { font-size: 13px; } .oh__row .oh__tht b { font-size: 17px; }

  .oh__foot { flex: none; display: flex; justify-content: space-between; gap: 18px; padding: 6px 24px 8px; font-size: 14px; }
  .oh__foot span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .oh__msg { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 24px 60px; gap: 14px; }
  .oh__msg svg { width: 96px; height: 96px; }
  .oh__msg h1 { margin: 0; font-size: 72px; line-height: 1; letter-spacing: -.02em; font-weight: 800; }
  .oh__msg p { font-size: 22px; margin: 0; max-width: 620px; }
  .oh__msg p.dim { font-size: 18px; }

  /* TRMNL X and other large panels: the same page, a size up. */
  .screen--lg .oh__band { font-size: 24px; padding: 14px 32px; }
  .screen--lg .oh__credit { right: 32px; top: 64px; font-size: 18px; }
  .screen--lg .oh__main { left: 32px; bottom: 30px; width: 600px; }
  .screen--lg .oh__cs { font-size: 128px; }
  .screen--lg .oh__typ { font-size: 36px; }
  .screen--lg .oh__line { font-size: 27px; }
  .screen--lg .oh__route { font-size: 30px; } .screen--lg .oh__route span { font-size: 24px; }
  .screen--lg .oh__strip { right: 32px; bottom: 30px; width: 340px; gap: 10px; }
  .screen--lg .oh__th { width: 90px; height: 60px; }
  .screen--lg .oh__tht { font-size: 18px; } .screen--lg .oh__tht b { font-size: 23px; }
  .screen--lg .oh__plate { width: 440px; margin: 26px 0 26px 32px; }
  .screen--lg .oh__plate svg { width: 330px; height: 330px; }
  .screen--lg .oh__fig { font-size: 18px; bottom: 14px; }
  .screen--lg .oh__note { padding: 20px 32px 0 34px; }
  .screen--lg .oh__note .oh__cs { font-size: 100px; }
  .screen--lg .oh__note .oh__typ { font-size: 32px; }
  .screen--lg .oh__stats { gap: 10px 24px; margin-top: 18px; }
  .screen--lg .oh__st small { font-size: 16px; } .screen--lg .oh__st b { font-size: 40px; }
  .screen--lg .oh__row { margin: 0 32px; }
  .screen--lg .oh__row li { padding: 12px 14px 14px 0; }
  .screen--lg .oh__row .oh__th { width: 72px; height: 48px; }
  .screen--lg .oh__row .oh__tht { font-size: 16px; } .screen--lg .oh__row .oh__tht b { font-size: 21px; }
  .screen--lg .oh__foot { padding: 8px 32px 12px; font-size: 17px; }
  .screen--lg .oh__msg h1 { font-size: 96px; } .screen--lg .oh__msg p { font-size: 28px; max-width: 800px; }

  /* 1-bit panels have no grey for a shade: text sits on solid black instead. */
  .screen--1bit .oh__shade { background: none; }
  .screen--1bit .oh--photo .oh__band { background: #000; padding-top: 10px; text-shadow: none; }
  .screen--1bit .oh__credit { background: #000; padding: 3px 8px; right: 0; top: 48px; text-shadow: none; }
  .screen--1bit .oh__main { background: #000; padding: 10px 14px 8px; left: 10px; bottom: 10px; text-shadow: none; }
  .screen--1bit .oh__strip { right: 10px; bottom: 10px; }
  .screen--1bit .oh__strip li { background: #000; }
  .screen--1bit.screen--lg .oh__credit { top: 60px; }
  .screen--1bit.screen--lg .oh__main { left: 16px; bottom: 16px; padding: 14px 18px 12px; }
  .screen--1bit.screen--lg .oh__strip { right: 16px; bottom: 16px; }

  /* Portrait: the strip stacks above the hero text, the plate above its note. */
  :is(.screen--portrait .oh, .oh--portrait) .oh__band { flex-direction: column; align-items: flex-start; gap: 2px; }
  :is(.screen--portrait .oh, .oh--portrait) .oh__credit { top: 86px; }
  :is(.screen--portrait .oh, .oh--portrait) .oh__main { right: 24px; width: auto; }
  :is(.screen--portrait .oh, .oh--portrait) .oh__strip { left: 24px; right: 24px; width: auto; bottom: 250px; display: grid; grid-template-columns: 1fr 1fr; }
  :is(.screen--portrait .oh, .oh--portrait) .oh__body { flex-direction: column; align-items: stretch; }
  :is(.screen--portrait .oh, .oh--portrait) .oh__plate { width: auto; height: 220px; margin: 18px 24px 0; }
  :is(.screen--portrait .oh, .oh--portrait) .oh__plate svg { width: 170px; height: 170px; }
  :is(.screen--portrait .oh, .oh--portrait) .oh__note { padding: 18px 24px 0; }
  :is(.screen--portrait .oh, .oh--portrait) .oh__row { flex-wrap: wrap; }
  :is(.screen--portrait .oh, .oh--portrait) .oh__row li { flex: 1 1 45%; }
  :is(.screen--portrait .oh, .oh--portrait) .oh__row li:nth-child(odd) { border-left: 0; padding-left: 0; }
  :is(.screen--portrait .oh, .oh--portrait) .oh__row li:nth-child(n+3) { border-top: 1px solid #000; }
  .screen--lg:is(.screen--portrait) .oh__credit, .screen--lg .oh--portrait .oh__credit { top: 104px; }
  .screen--lg:is(.screen--portrait) .oh__main, .screen--lg .oh--portrait .oh__main { right: 32px; }
  .screen--lg:is(.screen--portrait) .oh__strip, .screen--lg .oh--portrait .oh__strip { left: 32px; right: 32px; bottom: 330px; }
  .screen--lg:is(.screen--portrait) .oh__plate, .screen--lg .oh--portrait .oh__plate { height: 300px; margin: 26px 32px 0; }
  .screen--lg:is(.screen--portrait) .oh__plate svg, .screen--lg .oh--portrait .oh__plate svg { width: 240px; height: 240px; }
  .screen--lg:is(.screen--portrait) .oh__note .oh__cs, .screen--lg .oh--portrait .oh__note .oh__cs { font-size: 84px; }
</style>

<div class="oh oh--{{ look }}{{ portrait }}">
  {% if look == "photo" %}
    <img class="oh__bg" src="{{ hero.photo.src }}" alt="">
    <div class="oh__shade"></div>
  {% endif %}

  <div class="oh__band">
    <span>Overhead{% if placeName != "" and placeName != nil %} · {{ placeName }}{% endif %}</span>
    <span>{% if sky.error != true %}{{ sky.count }} in the air within {{ sky.radiusKm }} km · {% endif %}{{ clock }}</span>
  </div>

  {% if look == "silent" %}
    <div class="oh__msg">
      {{ sil_jet }}
      <h1>THE FEED IS SILENT</h1>
      <p>{% if sky.message contains "location" %}{{ sky.message }}{% else %}adsb.lol did not answer.{% endif %}</p>
      {% unless sky.message contains "location" %}<p class="dim">{{ sky.message }}</p>{% endunless %}
    </div>

  {% elsif look == "quiet" %}
    <div class="oh__msg">
      {{ sil_light }}
      <h1>QUIET SKY</h1>
      <p>Nothing in the air within {{ sky.radiusKm }} km of {{ sky.place }} at {{ clock }}.</p>
      {% if sky.lastSeen %}
        <p class="dim">Last overhead: {{ sky.lastSeen.cs }}{% if sky.lastSeen.airline != "" and sky.lastSeen.airline %}, {{ sky.lastSeen.airline }}{% endif %}, {{ sky.lastSeen.typ }}, at {{ sky.lastSeen.clock }}.</p>
      {% endif %}
    </div>
    <div class="oh__foot"><span>positions adsb.lol</span><span>read {{ clock }}</span></div>

  {% elsif look == "photo" %}
    <div class="oh__credit">photo {{ hero.photo.by }} · planespotters.net</div>
    <div class="oh__main">
      <div class="oh__cs">{{ hero.cs }}{% if hero.military %}<small>military</small>{% endif %}</div>
      <div class="oh__typ">{{ hero.typ }}{% if hero.reg != "" %} <span>· {{ hero.reg }}</span>{% endif %}</div>
      {% if hero.airline != "" and hero.airline != "private" %}<div class="oh__line">{{ hero.airline }}</div>{% endif %}
      {% if hero.route %}<div class="oh__route"><b>{{ hero.route.origin }}</b> <span>{{ hero.route.originCity }}</span> <svg class="oh__arrow" viewBox="0 0 28 12"><path d="M1 6h23M19 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg> <b>{{ hero.route.dest }}</b> <span>{{ hero.route.destCity }}</span></div>{% endif %}
      <div class="oh__line">{{ hero.altText }}{% if hero.ground == false %} · {{ hero.trend }}{% endif %}{% if hero.gs > 0 %} · {{ hero.gs }} kt{% endif %} · {{ hero.where }} · hdg {{ hero.heading }}°</div>
    </div>
    {% if sky.aircraft.size > 1 %}
      <ul class="oh__strip">
        {% for a in sky.aircraft offset: 1 limit: 4 %}
          <li>
            {% if a.photo %}<img class="oh__th" src="{{ a.photo.thumb }}" alt="">{% else %}<span class="oh__th oh__th--sil">{% case a.cls %}{% when "wide" %}{{ sil_wide }}{% when "prop" %}{{ sil_prop }}{% when "light" %}{{ sil_light }}{% when "biz" %}{{ sil_biz }}{% when "heli" %}{{ sil_heli }}{% else %}{{ sil_jet }}{% endcase %}</span>{% endif %}
            <span class="oh__tht"><b>{{ a.cs }}</b><span>{{ a.typ }}</span><span>{{ a.altText }} · {{ a.km }} km {{ a.compass }}</span></span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

  {% else %}
    <div class="oh__body">
      <div class="oh__plate">
        <i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i>
        <div style="transform: rotate({{ hero.trk }}deg)">{% case hero.cls %}{% when "wide" %}{{ sil_wide }}{% when "prop" %}{{ sil_prop }}{% when "light" %}{{ sil_light }}{% when "biz" %}{{ sil_biz }}{% when "heli" %}{{ sil_heli }}{% else %}{{ sil_jet }}{% endcase %}</div>
        <div class="oh__fig">{% if hero.ground %}on the ground{% else %}heading {{ hero.heading }}° · {{ hero.trend }}{% endif %}</div>
      </div>
      <div class="oh__note">
        <div class="oh__cs">{{ hero.cs }}{% if hero.military %}<small>military</small>{% endif %}</div>
        <div class="oh__typ">{{ hero.typ }}{% if hero.reg != "" %} <span>· {{ hero.reg }}</span>{% endif %}</div>
        {% if hero.airline != "" and hero.airline != "private" %}<div class="oh__line">{{ hero.airline }}</div>{% endif %}
        {% if hero.route %}<div class="oh__route"><b>{{ hero.route.origin }}</b> <span>{{ hero.route.originCity }}</span> <svg class="oh__arrow" viewBox="0 0 28 12"><path d="M1 6h23M19 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg> <b>{{ hero.route.dest }}</b> <span>{{ hero.route.destCity }}</span></div>{% endif %}
        <div class="oh__stats">
          <div class="oh__st"><small>Height</small><b>{{ hero.altText }}</b></div>
          <div class="oh__st"><small>Speed</small><b>{% if hero.gs > 0 %}{{ hero.gs }} kt{% else %}—{% endif %}</b></div>
          <div class="oh__st"><small>Distance · {{ hero.direction }}</small><b>{{ hero.km }} km</b></div>
          <div class="oh__st"><small>Heading</small><b>{{ hero.heading }}°</b></div>
        </div>
      </div>
    </div>
    {% if sky.aircraft.size > 1 %}
      <ul class="oh__row">
        {% for a in sky.aircraft offset: 1 limit: 4 %}
          <li>
            {% if a.photo %}<img class="oh__th" src="{{ a.photo.thumb }}" alt="">{% else %}{% case a.cls %}{% when "wide" %}{{ sil_wide }}{% when "prop" %}{{ sil_prop }}{% when "light" %}{{ sil_light }}{% when "biz" %}{{ sil_biz }}{% when "heli" %}{{ sil_heli }}{% else %}{{ sil_jet }}{% endcase %}{% endif %}
            <span class="oh__tht"><b>{{ a.cs }}</b><span>{{ a.typ }}</span><span>{{ a.altText }} · {{ a.where }}</span></span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
    <div class="oh__foot"><span>positions adsb.lol{% if sky.enriched %} · routes adsbdb{% endif %}</span><span>read {{ clock }}</span></div>
  {% endif %}
</div>
